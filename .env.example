# ─────────────────────────────────────────────────────────────────────────────
# SparkX configuration.  Copy this file to `.env` and fill in what you have.
# Everything here is optional: with no keys at all SparkX runs on the built-in
# `fake` provider, which is deterministic and needs no network.
# ─────────────────────────────────────────────────────────────────────────────

# Which provider the splitter uses.  One of: fake | openai | google | ollama | cli
SPARK_PROVIDER=fake

# Optional per-pass routing.  Pass B (finding the seams between frontend and
# backend) is the hard one — if you have a good cloud key, spend it here and
# leave A and C on a cheap or local model.
#   SPARK_PROVIDER_PASS_A=ollama
#   SPARK_PROVIDER_PASS_B=openai
#   SPARK_PROVIDER_PASS_C=ollama

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Override for Azure / a compatible gateway. Leave blank for api.openai.com.
OPENAI_BASE_URL=https://api.openai.com/v1

# ── Google Gemini ────────────────────────────────────────────────────────────
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash

# ── Ollama (local, no key needed) ────────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# ── CLI (agy, no key needed — real AI on your Google account login) ─────────
# The binary to drive headlessly. `gemini` is the older CLI; `codex` is
# mentioned in the plan but not implemented here (see server/models/cli.ts).
SPARK_CLI_BIN=agy
# Seconds before a call is given up on. Agy loads its own harness before it
# sees the prompt, so even "say ok" costs 10-30s — raise this if calls time out.
SPARK_CLI_TIMEOUT=600

# ── Engine ───────────────────────────────────────────────────────────────────
# Temperature 0 keeps splits reproducible.  Raise only when experimenting.
SPARK_TEMPERATURE=0
# How many times a malformed model response is fed its own validation error
# before SparkX gives up and hands you a partially-filled editor instead.
SPARK_MAX_REPAIRS=2
# Set to 0 to disable the prompt cache (useful when tuning prompts).
SPARK_CACHE=1

# ── Server ───────────────────────────────────────────────────────────────────
PORT=5178
SPARK_DB=./data/spark.db
