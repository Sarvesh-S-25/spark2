{
  "key": "markers.detail",
  "kind": "http",
  "semver": "1.0.0",
  "state": "locked",
  "spec": {
    "key": "markers.detail",
    "kind": "http",
    "direction": "client_to_server",
    "summary": "Full detail for one marker, loaded on tap.",
    "transport": {
      "method": "GET",
      "path": "/api/markers/:id",
      "symbol": "detailMarkers"
    },
    "input": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        }
      },
      "required": [
        "id"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "speedKph": {
          "type": "number"
        },
        "lastSeenAt": {
          "type": "string",
          "format": "date-time"
        },
        "history": {
          "type": "array",
          "items": {
            "type": "object"
          },
          "description": "recent positions"
        }
      },
      "required": [
        "id",
        "label",
        "kind",
        "lastSeenAt"
      ]
    },
    "errors": [
      {
        "code": "MARKER_NOT_FOUND",
        "when": "no marker with that id",
        "http": 404
      }
    ]
  },
  "examples": [
    {
      "input": {
        "id": "id_101"
      },
      "output": {
        "id": "id_101",
        "label": "label-2",
        "kind": "kind-3",
        "speedKph": 12.94,
        "lastSeenAt": "2026-01-01T09:05:00.000Z",
        "history": [
          {}
        ]
      }
    }
  ],
  "spec_hash": "sha256:1c1d5d62cf22b3a650e946eda57d4c7ac000e08a101035b5d2f9e48cadac8a6e"
}
