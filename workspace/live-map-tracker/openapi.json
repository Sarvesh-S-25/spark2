{
  "openapi": "3.1.0",
  "info": {
    "title": "Live map tracker API",
    "version": "1.0.0",
    "description": "Generated by SparkX from its internal contract format. This document covers the http contracts only — function, event and type contracts have no OpenAPI representation and live in .spark/contracts/."
  },
  "paths": {
    "/api/app/config": {
      "get": {
        "operationId": "app_config",
        "summary": "Runtime settings the client needs before it can render anything.",
        "description": "SparkX contract app.config@1.0.0 (locked). Spec hash sha256:5aaf7ac1d1d4ffc3ae6a277691a6562fe3db38f309b0a1dcf1fe89b950e0ec54.",
        "tags": [
          "app"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "appName": {
                      "type": "string"
                    },
                    "apiBaseUrl": {
                      "type": "string"
                    },
                    "features": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "appName",
                    "apiBaseUrl"
                  ]
                },
                "examples": {
                  "example1": {
                    "value": {
                      "appName": "appName-1",
                      "apiBaseUrl": "apiBaseUrl-2",
                      "features": [
                        "features-a",
                        "features-b"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/map/config": {
      "get": {
        "operationId": "map_config",
        "summary": "Tile provider and default viewport, served once at startup.",
        "description": "SparkX contract map.config@1.0.0 (locked). Spec hash sha256:1e9307a37a257a642479feb77c66f42e762df381247040bc31255214cf5af39f.",
        "tags": [
          "map"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "tileUrl": {
                      "type": "string",
                      "description": "XYZ tile template"
                    },
                    "defaultCenterLat": {
                      "type": "number"
                    },
                    "defaultCenterLng": {
                      "type": "number"
                    },
                    "defaultZoom": {
                      "type": "number"
                    },
                    "maxZoom": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "tileUrl",
                    "defaultCenterLat",
                    "defaultCenterLng",
                    "defaultZoom"
                  ]
                },
                "examples": {
                  "example1": {
                    "value": {
                      "tileUrl": "tileUrl-1",
                      "defaultCenterLat": 12.92,
                      "defaultCenterLng": 12.93,
                      "defaultZoom": 12.94,
                      "maxZoom": 12.95
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/markers/{id}": {
      "get": {
        "operationId": "markers_detail",
        "summary": "Full detail for one marker, loaded on tap.",
        "description": "SparkX contract markers.detail@1.0.0 (locked). Spec hash sha256:1c1d5d62cf22b3a650e946eda57d4c7ac000e08a101035b5d2f9e48cadac8a6e.",
        "tags": [
          "markers"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "label": {
                      "type": "string"
                    },
                    "kind": {
                      "type": "string"
                    },
                    "speedKph": {
                      "type": "number"
                    },
                    "lastSeenAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "history": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      },
                      "description": "recent positions"
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "kind",
                    "lastSeenAt"
                  ]
                },
                "examples": {
                  "example1": {
                    "value": {
                      "id": "id_101",
                      "label": "label-2",
                      "kind": "kind-3",
                      "speedKph": 12.94,
                      "lastSeenAt": "2026-01-01T09:05:00.000Z",
                      "history": [
                        {}
                      ]
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "MARKER_NOT_FOUND — no marker with that id",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "MARKER_NOT_FOUND"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/markers": {
      "get": {
        "operationId": "markers_list",
        "summary": "Markers currently inside the visible bounding box.",
        "description": "SparkX contract markers.list@1.0.0 (locked). Spec hash sha256:cee8e41453f94899f75fd9127f87c5dce6cc95a4181d446b7ee717f365c37434.",
        "tags": [
          "markers"
        ],
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": true,
            "schema": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "description": "west, south, east, north"
            },
            "description": "west, south, east, north"
          },
          {
            "name": "since",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "only markers updated after this instant"
            },
            "description": "only markers updated after this instant"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string"
                      },
                      "lat": {
                        "type": "number"
                      },
                      "lng": {
                        "type": "number"
                      },
                      "label": {
                        "type": "string"
                      },
                      "kind": {
                        "type": "string"
                      },
                      "updatedAt": {
                        "type": "string",
                        "format": "date-time"
                      }
                    },
                    "required": [
                      "id",
                      "lat",
                      "lng",
                      "label",
                      "kind",
                      "updatedAt"
                    ]
                  }
                },
                "examples": {
                  "example1": {
                    "value": [
                      {
                        "id": "id_101",
                        "lat": 12.92,
                        "lng": 12.93,
                        "label": "label-4",
                        "kind": "kind-5",
                        "updatedAt": "2026-01-01T09:01:00.000Z"
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "BBOX_INVALID — bbox is not [w,s,e,n]",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "BBOX_INVALID"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/api/positions": {
      "post": {
        "operationId": "positions_ingest",
        "summary": "A device or vehicle reporting where it is.",
        "description": "SparkX contract positions.ingest@1.0.0 (locked). Spec hash sha256:99c3eef72ebb94502d1455a5a35409549921a9365df71c3bbbc3fd7659ca256e.",
        "tags": [
          "positions"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "deviceId": {
                    "type": "string"
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lng": {
                    "type": "number"
                  },
                  "headingDeg": {
                    "type": "number"
                  },
                  "at": {
                    "type": "string",
                    "format": "date-time"
                  }
                },
                "required": [
                  "deviceId",
                  "lat",
                  "lng",
                  "at"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "accepted"
                  ]
                },
                "examples": {
                  "example1": {
                    "value": {
                      "accepted": 12.91
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "COORDS_INVALID — lat/lng out of range",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "enum": [
                        "COORDS_INVALID"
                      ]
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "code"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Marker": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "lat": {
            "type": "number"
          },
          "lng": {
            "type": "number"
          },
          "label": {
            "type": "string"
          },
          "kind": {
            "type": "string"
          },
          "headingDeg": {
            "type": "number"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "lat",
          "lng",
          "label",
          "kind",
          "updatedAt"
        ]
      }
    }
  }
}
